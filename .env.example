# Copy to .env for local development. Railway sets these as service variables.

# Local Postgres (see README for the podman command)
DATABASE_URL=postgres://customerwise:customerwise@localhost:5432/customerwise

# --- Production / Railway only ---
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=customerwise-production.up.railway.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://customerwise-production.up.railway.app
# DEFAULT_FROM_EMAIL=Customer Wise <no-reply@your-domain>
# BREVO_API_KEY=

# Railway bucket (map from the bucket's own variables)
# BUCKET_NAME=
# BUCKET_ENDPOINT_URL=
# BUCKET_REGION=auto
# BUCKET_ACCESS_KEY_ID=
# BUCKET_SECRET_ACCESS_KEY=
